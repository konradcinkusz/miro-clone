@using MiroClone.Web.Canvas.Core

<rect class="board-layer" data-testid="layer-rectangle" data-layer-id="@Layer.Id"
      x="@SvgFormat.Num(Layer.X)" y="@SvgFormat.Num(Layer.Y)"
      width="@SvgFormat.Num(Layer.Width)" height="@SvgFormat.Num(Layer.Height)"
      fill="@Layer.Fill.ToHex()" />

@code {
    [Parameter, EditorRequired]
    public Layer Layer { get; set; } = null!;
}
