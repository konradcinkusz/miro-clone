@using MiroClone.Web.Canvas.Core

<text class="board-text" data-testid="layer-text" data-layer-id="@Layer.Id"
      x="@SvgFormat.Num(Layer.X + Padding)" y="@SvgFormat.Num(Layer.Y + Layer.Height / 2)"
      dominant-baseline="middle" fill="@Layer.Fill.ToHex()">@Layer.Value</text>

@code {
    /// <summary>Inset from the box edge, in world units.</summary>
    private const double Padding = 8;

    [Parameter, EditorRequired]
    public Layer Layer { get; set; } = null!;
}
