@using MiroClone.Web.Canvas.Interaction

<nav class="board-toolbar" aria-label="Tools">
    @foreach (var (tool, label) in Tools)
    {
        var active = tool == Active;
        <button type="button" class="btn @(active ? "btn-primary" : "btn-quiet")"
                aria-pressed="@(active ? "true" : "false")"
                data-testid="tool-@tool.ToString().ToLowerInvariant()"
                @onclick="() => OnSelect.InvokeAsync(tool)">@label</button>
    }
    <button type="button" class="btn btn-quiet" data-testid="undo" title="Undo (Ctrl+Z)"
            disabled="@(!CanUndo)" @onclick="() => OnUndo.InvokeAsync()">Undo</button>
    <button type="button" class="btn btn-quiet" data-testid="redo" title="Redo (Ctrl+Shift+Z)"
            disabled="@(!CanRedo)" @onclick="() => OnRedo.InvokeAsync()">Redo</button>
</nav>

@code {
    private static readonly (CanvasTool Tool, string Label)[] Tools =
    [
        (CanvasTool.Select, "Select"),
        (CanvasTool.Rectangle, "Rectangle"),
        (CanvasTool.Ellipse, "Ellipse"),
        (CanvasTool.Text, "Text"),
        (CanvasTool.Note, "Note"),
        (CanvasTool.Pencil, "Pencil"),
    ];

    [Parameter, EditorRequired]
    public CanvasTool Active { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<CanvasTool> OnSelect { get; set; }

    [Parameter]
    public bool CanUndo { get; set; }

    [Parameter]
    public bool CanRedo { get; set; }

    [Parameter]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public EventCallback OnRedo { get; set; }
}
