@using MiroClone.Web.Canvas.Realtime

<header class="board-header">
    <a class="btn btn-quiet" href="/" data-testid="back-to-boards">Boards</a>
    <h1 class="board-title" data-testid="board-title">@Title</h1>
    <ParticipantAvatars Participants="Participants" />
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Everyone on the board, the signed-in user first. Comes from the live session (WP10).</summary>
    [Parameter]
    public IReadOnlyList<ParticipantView> Participants { get; set; } = [];
}
