@using MiroClone.Web.Canvas.Realtime

@if (State != CanvasConnectionState.Live || EditsPaused)
{
    <p class="callout @Tone" role="status" data-testid="connection-banner" data-state="@StateName">@Message</p>
}

@code {
    /// <summary>The board's live connection. Nothing is shown while it is live and edits are flowing.</summary>
    [Parameter, EditorRequired]
    public CanvasConnectionState State { get; set; }

    /// <summary>True when the outbox is full and new edits are refused (ADR 0035).</summary>
    [Parameter]
    public bool EditsPaused { get; set; }

    private string Message => EditsPaused
        ? "Too many edits are waiting to be sent, so new edits are paused until the connection returns."
        : State switch
        {
            CanvasConnectionState.Connecting => "Connecting to live updates…",
            CanvasConnectionState.Reconnecting => "Connection lost. Reconnecting; your edits stay on this screen and are sent when it returns.",
            _ => "Live updates are unavailable for this board. Reload the page to try again.",
        };

    private string Tone => State == CanvasConnectionState.Connecting && !EditsPaused ? string.Empty : "callout-warning";

    private string StateName => State.ToString().ToLowerInvariant();
}
