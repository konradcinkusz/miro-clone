@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="app-header">
    <a class="brand" href="/">MiroClone</a>
    <AuthorizeView>
        <Authorized>
            <span class="app-header-user" data-testid="signed-in-email">@context.User.Identity?.Name</span>
            <a class="btn btn-quiet" href="/sign-out" data-testid="sign-out-link">Sign out</a>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-quiet" href="/sign-in">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<main id="main-content" class="page">
    @Body
</main>
