@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@using MiroClone.Web.Components.Shared

<PageTitle>Forgot your password · MiroClone</PageTitle>

<section class="card narrow" aria-labelledby="forgot-heading">
    <h1 id="forgot-heading">Forgot your password?</h1>

    <StatusAlert Message="@Error" />
    @if (Sent == "1")
    {
        <p class="callout callout-success" role="status">
            If an account exists for that address, a reset link is on its way.
        </p>
    }

    <form method="post" action="/account/forgot-password" class="stack" data-testid="forgot-form">
        <AntiforgeryToken />
        <div class="field">
            <label for="forgot-email">Email</label>
            <input id="forgot-email" name="email" type="email" autocomplete="email" required maxlength="256" />
        </div>
        <button class="btn btn-primary" type="submit" data-testid="forgot-submit">Send reset link</button>
    </form>

    <p class="muted"><a href="/sign-in">Back to sign in</a></p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }
}
