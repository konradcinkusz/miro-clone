@page "/sign-in"
@using MiroClone.Web.Auth
@using MiroClone.Web.Account
@using MiroClone.Web.Components.Shared
@inject DemoLoginHint Hint

<PageTitle>Sign in · MiroClone</PageTitle>

<section class="card narrow" aria-labelledby="sign-in-heading">
    <h1 id="sign-in-heading">Sign in</h1>

    <StatusAlert Message="@Error" />
    @if (Verified == "1")
    {
        <p class="callout callout-success" role="status">Your email address is verified. Sign in to continue.</p>
    }
    @if (PasswordReset == "1")
    {
        <p class="callout callout-success" role="status">Your password was changed. Sign in with the new one.</p>
    }

    <form method="post" action="/account/sign-in" class="stack" data-testid="sign-in-form">
        <InteractiveFieldset>
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
        <div class="field">
            <label for="sign-in-email">Email</label>
            <input id="sign-in-email" name="email" type="email" autocomplete="email" required maxlength="256" value="@email" />
        </div>
        <div class="field">
            <label for="sign-in-password">Password</label>
            <input id="sign-in-password" name="password" type="password" autocomplete="current-password" required value="@password" />
        </div>
        <button class="btn btn-primary" type="submit" data-testid="sign-in-submit">Sign in</button>
        </InteractiveFieldset>
    </form>

    @if (Hint.Visible)
    {
        <aside class="callout" data-testid="demo-logins" aria-labelledby="demo-logins-heading">
            <h2 id="demo-logins-heading">Demo logins (development only)</h2>
            <p class="muted">Created by the seed. Password for all: <code>@DemoLogins.Password</code></p>
            <ul class="stack">
                @foreach (var login in DemoLogins.All)
                {
                    <li>
                        <InteractiveFieldset>
                            <button type="button" class="btn" data-testid="demo-login" data-email="@login.Email" @onclick="() => Fill(login)">@login.Email</button>
                        </InteractiveFieldset>
                        <span class="muted">@login.Role of @login.Workspace</span>
                    </li>
                }
            </ul>
        </aside>
    }

    <p class="muted">
        <a href="/sign-up">Create an account</a> · <a href="/forgot-password">Forgot your password?</a>
    </p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "verified")]
    public string? Verified { get; set; }

    [SupplyParameterFromQuery(Name = "reset")]
    public string? PasswordReset { get; set; }

    private string? email;
    private string? password;

    /// <summary>Fills the form (interactive only: the button is disabled while the page is prerendered). Nothing is submitted.</summary>
    private void Fill(DemoLogin login)
    {
        email = login.Email;
        password = DemoLogins.Password;
    }

    private string SafeReturnUrl => LocalReturnUrl.Resolve(ReturnUrl);
}
