@page "/board/{BoardId:guid}"
@attribute [Authorize]
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using MiroClone.ServiceDefaults
@using MiroClone.Web.Api
@using MiroClone.Web.Auth
@using Microsoft.AspNetCore.Components.Web
@using MiroClone.Web.Canvas.Core
@using MiroClone.Web.Canvas.Editing
@using MiroClone.Web.Canvas.Interaction
@using MiroClone.Web.Canvas.Realtime
@using MiroClone.Web.Components.Board
@using MiroClone.Web.Components.Shared
@inject ICurrentSession Session
@inject CanvasClient Canvas
@inject BoardsClient Boards
@inject ICanvasSessionFactory Realtime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>@(title is null ? "Board" : title + " · MiroClone")</PageTitle>

@if (loading)
{
    <p class="muted" role="status" data-testid="board-loading">Loading board…</p>
}
else if (notFound)
{
    <section class="empty-state" data-testid="board-not-found" aria-labelledby="not-found-heading">
        <h1 id="not-found-heading">Board not found</h1>
        <p>It may have been deleted, or it belongs to another workspace.</p>
        <p><a href="/">Back to boards</a></p>
    </section>
}
else if (session is { } live && editor is not null && frame is not null)
{
    <ConnectionBanner State="live.Connection" />
    <BoardHeader Title="@(title ?? string.Empty)" Participants="live.Participants" />

    @* The keyboard is read here, on the page, so it works wherever focus is on the board: the canvas, the toolbar or the selection bar. *@
    <div class="board-shell" @onkeydown="HandleKey">
        <div class="cluster">
            <BoardToolbar Active="editor.Tool" OnSelect="SelectTool" CanUndo="frame.CanUndo" CanRedo="frame.CanRedo"
                          OnUndo="Undo" OnRedo="Redo" />
            <SelectionBar Visible="frame.Selection.Count > 0" OnColour="SetFill" OnFront="BringToFront"
                          OnBack="SendToBack" OnDelete="DeleteSelection" />
        </div>

        <CanvasSurface Frame="frame" Remote="live.RemoteParticipants" OnInput="HandleInput" OnEditText="EditText" OnFinishEdit="FinishEdit" />
    </div>

    @if (frame.Notice is { } notice)
    {
        <p class="callout callout-warning" role="status" data-testid="board-notice">@notice</p>
    }
}

<StatusAlert Message="@error" />

@code {
    private const string LoadFailed = "This board could not be loaded. Try again in a moment.";

    private readonly CancellationTokenSource lifetime = new();
    private IRealtimeCanvasSession? session;
    private BoardEditor? editor;
    private CanvasFrame? frame;
    private string? title;
    private Point? cursor;
    private string? error;
    private bool loading = true;
    private bool notFound;
    private Guid? loadedBoard;

    [Parameter]
    public Guid BoardId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedBoard == BoardId)
        {
            return;
        }

        loadedBoard = BoardId;
        await CloseSessionAsync();
        await LoadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        lifetime.Dispose();
        await CloseSessionAsync();
    }

    /// <summary>
    /// Loads the board's layers from the canvas service and its title from the boards list. The canvas answers 404 for a board
    /// outside the session's workspace; that and a missing title both show the not-found state (ADR 0032).
    /// </summary>
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        notFound = false;
        var ct = lifetime.Token;

        try
        {
            var sessionId = await Session.IdAsync();
            var principal = await Session.PrincipalAsync();
            if (sessionId is null || principal is null)
            {
                Navigation.NavigateTo(LocalReturnUrl.SignInFor("/board/" + BoardId.ToString("D")), forceLoad: true);
                return;
            }

            if (WorkspaceClaims.UserId(principal) is not { } selfId)
            {
                error = LoadFailed;
                return;
            }

            var state = await Canvas.GetAsync(sessionId, BoardId, ct);
            var board = await Boards.FindAsync(sessionId, BoardId, ct);
            if (board is null)
            {
                notFound = true;
                return;
            }

            title = board.Title;
            // The live session starts from the REST state and is replaced by the hub's state as soon as the room answers (WP10).
            session = Realtime.Open(
                sessionId,
                selfId,
                principal.Identity?.Name ?? string.Empty,
                BoardId,
                CanvasStateMapper.ToDocument(state),
                new ComponentDispatcher(work => InvokeAsync(work)));
            session.Changed += OnRealtimeChanged;
            session.Start();
            editor = new BoardEditor(session);
            frame = editor.Frame();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            notFound = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or FormatException or ArgumentException)
        {
            // A failed or malformed load is one alert; the page stays usable from the dashboard link.
            error = LoadFailed;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The page was disposed mid-load. Nothing is shown and nothing is left running.
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleInput(CanvasInput input)
    {
        // The cursor is read off the camera before the input applies, so it is where the pointer is (ADR 0036).
        if (input is PointerInput pointer && editor is not null)
        {
            cursor = editor.Camera.ScreenToWorld(pointer.Screen);
        }

        Act(board => board.Apply(input));
    }

    /// <summary>Ctrl or Meta is read as one flag, so Ctrl+Z and Cmd+Z do the same.</summary>
    private void HandleKey(KeyboardEventArgs args) =>
        Act(board => board.Key(new KeyInput(args.Key, args.CtrlKey || args.MetaKey, args.ShiftKey)));

    private void SelectTool(CanvasTool tool) => Act(board => board.SelectTool(tool));

    private void SetFill(Rgb fill) => Act(board => board.SetFill(fill));

    private void BringToFront() => Act(board => board.BringToFront());

    private void SendToBack() => Act(board => board.SendToBack());

    private void DeleteSelection() => Act(board => board.DeleteSelection());

    private void Undo() => Act(board => board.Undo());

    private void Redo() => Act(board => board.Redo());

    private void EditText(string text) => Act(board => board.EditText(text));

    private void FinishEdit() => Act(board => board.FinishEdit());

    /// <summary>Runs one editor change, then reads the frame the markup draws. Every change comes through here.</summary>
    private void Act(Action<BoardEditor> change)
    {
        if (editor is null)
        {
            return;
        }

        change(editor);
        frame = editor.Frame();
        Announce();
    }

    /// <summary>A remote change, a participant or the connection changed. Runs on the page's dispatcher, so the page reacts directly.</summary>
    private void OnRealtimeChanged() => _ = InvokeAsync(() =>
    {
        // A remote delete may have removed a selected layer; the selection is brought back in line before the frame is drawn.
        editor?.Reconcile();
        if (editor is not null)
        {
            frame = editor.Frame();
        }

        StateHasChanged();
    });

    /// <summary>Tells the room where this user's pointer is and what is selected (ADR 0036). The session paces the sends.</summary>
    private void Announce() => session?.SetPresence(cursor, frame?.Selection ?? []);

    private async Task CloseSessionAsync()
    {
        var closing = session;
        session = null;
        editor = null;
        frame = null;

        if (closing is not null)
        {
            closing.Changed -= OnRealtimeChanged;
            await closing.DisposeAsync();
        }
    }
}
