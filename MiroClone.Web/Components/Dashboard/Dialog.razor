@* A modal dialog shell: a labelled dialog that closes on Escape. Focus is placed by the first control's autofocus. *@
<div class="dialog-backdrop">
    <div class="card dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId" data-testid="@TestId" @onkeydown="OnKeyDown">
        <h2 id="@_titleId">@Title</h2>
        @ChildContent
    </div>
</div>

@code {
    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
