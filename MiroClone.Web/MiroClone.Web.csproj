<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Blazor Web App, interactive Server render mode (ADR 0001). The circuit is the BFF: tokens stay server-side.
    References the kernel only (blazor-web-app §4). Blazor WebAssembly is not used.
  -->
  <PropertyGroup>
    <RootNamespace>MiroClone.Web</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiroClone.ServiceDefaults\MiroClone.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The circuit's client for the canvas hub (WP10, ADR 0033). Version in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

</Project>
