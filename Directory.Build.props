<Project>

  <!--
    Shared build settings for every project in the solution.
    Warnings are errors: a warning that is tolerated today is a regression nobody sees tomorrow.
    Versions are NOT set here; they live only in Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!--
      Vulnerable packages fail restore: any advisory at "low" or above is reported as a
      warning (NU1901..NU1904), and TreatWarningsAsErrors turns that into a failed build.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

</Project>
