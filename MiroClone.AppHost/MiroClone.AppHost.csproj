<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aspire composition root (P1): one command runs the estate for development. It is not the production topology
    (P1, P7). The Aspire AppHost SDK supplies the DCP and dashboard paths; its version is pinned in global.json
    (msbuild-sdks), not here (ADR 0008).
  -->
  <Sdk Name="Aspire.AppHost.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MiroClone.AppHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Enables the Aspire CLI bundle, which the orchestration features need (ASPIRE010). ADR 0008. -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- Holds the development secrets the estate reads, such as the authservice signing key (docs/AUTH.md). Not a credential. -->
    <UserSecretsId>ec22214a-d49f-4a69-87c5-32616414d3e6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

</Project>
