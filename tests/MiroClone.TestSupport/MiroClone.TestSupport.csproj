<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test helper: a local authservice stand-in and token factory (WP03). Referenced only by test projects.
    It opens no socket: the authority is an in-process TestServer, so no test needs the network.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>MiroClone.TestSupport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MiroClone.ServiceDefaults\MiroClone.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
