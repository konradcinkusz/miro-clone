<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Layers per board (ADR 0003). Owns the "canvas" PostgreSQL database; no other service opens it.
    Program.cs is the manifest (P9); wiring lives in ServiceCollectionExtensions.
  -->
  <PropertyGroup>
    <RootNamespace>MiroClone.CanvasService</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiroClone.ServiceDefaults\MiroClone.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- design time only: dotnet ef migrations add -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
